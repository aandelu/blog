---
import type { Author, Essay } from '../lib/essays';
import { essayUrl } from '../lib/urls';
import { inlineMarkup } from '../lib/text';

interface Props {
  parent: Essay;
  parentAuthor: Author;
}

const { parent, parentAuthor } = Astro.props;
---
<p class="reply">
  <svg width="14" height="14" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M3 13V7a3 3 0 0 1 3-3h7"></path><path d="M10 1l3 3-3 3"></path></svg>
  <span>In reply to {parentAuthor.data.name}, <a href={essayUrl(parent.id)} set:html={inlineMarkup(parent.data.title)} /></span>
</p>
