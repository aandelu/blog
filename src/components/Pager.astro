---
import { siteConfig } from '../site.config';

interface Props {
  prev?: string;
  next?: string;
}

const { prev, next } = Astro.props;
---
<footer class="pager">
  <span>
    {next && (
      <a href={next}>Older essays <svg width="14" height="14" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M2 8h11"></path><path d="M9 4l4 4-4 4"></path></svg></a>
    )}
  </span>
  <span>
    {prev && (
      <a href={prev}><svg width="14" height="14" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M14 8H3"></path><path d="M7 4L3 8l4 4"></path></svg> Newer essays</a>
    )}
    {!prev && <span class="site">{siteConfig.name}</span>}
  </span>
</footer>
