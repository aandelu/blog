---
// The editor. This page IS the essay page: same layout, same stylesheet,
// with a bar on top and the fields made editable.
import Base from '../layouts/Base.astro';
import Masthead from '../components/Masthead.astro';
import { siteConfig } from '../site.config';
import { allAuthors } from '../lib/essays';
import { url } from '../lib/urls';

const authors = await allAuthors();
const config = {
  repo: siteConfig.repo,
  branch: siteConfig.branch,
  essaysDir: siteConfig.essaysDir,
  base: url('/'),
  authors: authors.map((a) => ({ id: a.id, name: a.data.name, color: a.data.color })),
};
---
<Base title="Write" bodyClass="writing">
  <div class="topbar">
    <a class="topbar-link" href={url('/')}>
      <svg width="14" height="14" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M10 3L5 8l5 5"></path></svg>
      Essays
    </a>
    <div class="status" id="status"><span class="status-dot" id="status-dot"></span><span id="status-text">Loading</span></div>
    <div class="topbar-actions">
      <button type="button" class="btn-quiet" id="btn-settings">Settings</button>
      <button type="button" class="btn" id="btn-publish">Publish</button>
    </div>
  </div>

  <div class="page">
    <div class="col"><Masthead /></div>
    <div class="col drafts" id="drafts" hidden></div>
    <p class="col editor-hint" id="token-hint" hidden>No GitHub token on this device yet. You can write and autosave now; add the token from <strong>Settings</strong> when you want to publish.</p>

    <article class="essay">
      <header class="col essay-header">
        <div class="meta"><span class="dot" id="author-dot"></span><span class="author" id="author-name"></span><span class="sep">·</span><time id="date-text"></time></div>
        <h1 class="essay-title" id="title" contenteditable="plaintext-only" data-placeholder="Title" spellcheck="true"></h1>
        <p class="dek" id="dek" contenteditable="plaintext-only" data-placeholder="A one-line summary for the front page" spellcheck="true"></p>
        <p class="essay-book">On <span class="book-title" id="book-title" contenteditable="plaintext-only" data-placeholder="the book, if there is one"></span>, by <span id="book-author" contenteditable="plaintext-only" data-placeholder="its author"></span></p>
        <div class="fields">
          <label>Reply to <select id="reply-to"><option value="">nothing</option></select></label>
          <label>Publish as <select id="author"></select></label>
          <label>Date <input id="date" type="date" /></label>
          <label>Slug <input id="slug" type="text" spellcheck="false" autocomplete="off" placeholder="from-the-title" /></label>
        </div>
      </header>
      <div class="col essay-body is-empty" id="editor"></div>
      <p class="col editor-hint">Select text to format it. <kbd>Ctrl</kbd> or <kbd>⌘</kbd> + <kbd>Shift</kbd> + <kbd>N</kbd> adds a margin note where the cursor is. Drafts save to this browser as you type.</p>
    </article>
  </div>

  <div class="fmt-bar" id="fmt-bar" hidden>
    <button type="button" data-cmd="bold" title="Bold">B</button>
    <button type="button" data-cmd="italic" class="italic" title="Italic">I</button>
    <button type="button" data-cmd="heading" title="Section heading">H</button>
    <button type="button" data-cmd="quote" title="Quotation"><svg width="16" height="16" viewBox="0 0 16 16" fill="currentColor" aria-hidden="true"><path d="M3 9.5C3 6.6 4.4 4.6 6.9 3.5l.5 1C6 5.2 5.3 6.2 5.1 7.5H7v4H3V9.5zm6 0c0-2.9 1.4-4.9 3.9-6l.5 1c-1.4.7-2.1 1.7-2.3 3H13v4H9V9.5z"></path></svg></button>
    <button type="button" data-cmd="link" title="Link"><svg width="16" height="16" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" aria-hidden="true"><path d="M6.5 9.5l3-3"></path><path d="M7 4.5l1-1a2.5 2.5 0 0 1 3.5 3.5l-1 1"></path><path d="M9 11.5l-1 1a2.5 2.5 0 0 1-3.5-3.5l1-1"></path></svg></button>
    <button type="button" data-cmd="note" class="wide" title="Turn the selection into a margin note">Note</button>
  </div>

  <dialog class="settings" id="settings">
    <h2>Publishing</h2>
    <p>Publishing commits the essay to <strong>{siteConfig.repo}</strong> on the <strong>{siteConfig.branch}</strong> branch. GitHub then rebuilds the site. To do that from this browser, the editor needs a token from your GitHub account. It stays in this browser only.</p>
    <ol>
      <li>Open <a href="https://github.com/settings/personal-access-tokens/new" target="_blank" rel="noopener">github.com/settings/personal-access-tokens/new</a>.</li>
      <li>Under Repository access choose <em>Only select repositories</em> and pick <strong>{siteConfig.repo}</strong>.</li>
      <li>Under Permissions, set <em>Contents</em> to <em>Read and write</em>. Leave everything else alone.</li>
      <li>Generate it, copy it, and paste it below.</li>
    </ol>
    <p class="note" id="settings-note" hidden></p>
    <label for="token">GitHub token</label>
    <input id="token" type="password" autocomplete="off" spellcheck="false" placeholder="github_pat_…" />
    <div class="row">
      <button type="button" class="btn-quiet" id="token-forget">Forget token</button>
      <button type="button" class="btn-quiet" id="token-close">Close</button>
      <button type="button" class="btn" id="token-save">Save token</button>
    </div>
  </dialog>

  <div class="toast" id="toast" hidden></div>

  <script is:inline type="application/json" id="write-config" set:html={JSON.stringify(config)} />
  <script>
    import { mountEditor } from '../editor/editor';
    mountEditor();
  </script>
</Base>
