---
import Base from '../layouts/Base.astro';
import Masthead from '../components/Masthead.astro';
---
<Base title="About">
  <div class="page">
    <div class="col">
      <Masthead />
      <header class="essay-header">
        <h1 class="essay-title">About</h1>
      </header>
      <div class="essay-body prose">
        <p>[Write a short introduction here: who you are, what the blog is for, and how the replies work. This text lives in <code>src/pages/about.astro</code>.]</p>
      </div>
    </div>
  </div>
</Base>
